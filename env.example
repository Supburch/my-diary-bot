# .env.example — copy เป็น .env แล้วเติมค่าจริง

# PostgreSQL (asyncpg format)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/diarybot

# Redis
REDIS_URL=redis://localhost:6379/0

# LINE
LINE_CHANNEL_ACCESS_TOKEN=your_token_here
LINE_CHANNEL_SECRET=your_secret_here

# Optional (ค่า default ใน Settings)
# WAKE_WORD=บอต
REMINDER_HOUR=22
REMINDER_ENABLED=true
# WEBHOOK_CONCURRENCY=20
# POOL_SIZE=5
# MAX_OVERFLOW=5
# RATE_LIMIT_COUNT=20
# RATE_LIMIT_WINDOW_SEC=5
# REDIS_LOCK_TTL_SEC=10

# Supabase (สำหรับจัดเก็บรูปภาพ Infographic)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
